{
  "systemCmd": "checkupdates 2>/dev/null",
  "aurCmd": "paru -Qua 2>/dev/null",
  "updateCmd": "ghostty -e bash -c 'echo \"Updating System...\";paru; flatpak update; read -n 1 -p \"Press any key to exit...\"'",
  "aurHomepageCmd": "LC_ALL=C paru -Si {id} 2>/dev/null | awk '/^URL/ {print $3}'",
  "flatpak": true,
  "noctalia": true,
  "toast": true,
  "desktopTip": true,
  "hideOnEmpty": true,
  "refreshTimer": true,
  "refreshInterval": 720,
  "iconName": "versions",
  "useDistroLogo": false,
  "customIconPath": "",
  "boldText": true,
  "enableColorization": true,
  "iconColor": "none",
  "boldVer": true,
  "tooltip": true,
  "closeButton": true,
  "closeOnSettings": true,
  "panelTooltip": true,
  "panelContext": true,
  "boldVerPanel": true,
  "boldVerDesktop": true,
  "hoverTip": true,
  "checkCmd": "(checkupdates; paru -Qua) 2>/dev/null",
  "nameCmd": "(checkupdates; paru -Qua;) | awk '{print $1}'",
  "oldVerCmd": "(checkupdates; paru -Qua;) | awk '{print $2}'",
  "newVerCmd": "(checkupdates; paru -Qua;) | awk '{print $4}'"
}
