// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &" // Polkit

    // spawn-sh-at-startup "qs -c noctalia-shell"
    spawn-at-startup "noctalia"
    // spawn-at-startup "$HOME/.local/bin/noctalia-switch" "v5"
	// spawn-sh-at-startup "$HOME/.local/bin/noctalia-switch v5 > /tmp/noctalia-switch.log 2>&1"

    spawn-sh-at-startup "swayidle -w before-sleep 'qs -c noctalia-shell ipc call lockScreen lock'"

    spawn-sh-at-startup "$HOME/.config/niri/scripts/niri-laptop-wake.sh"
    spawn-sh-at-startup "$HOME/.config/niri/scripts/auto-dnd.sh"

    spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
    spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

    spawn-at-startup "~/.local/bin/niri-sidebar" "listen"
