    window-rule {
        geometry-corner-radius 10
        clip-to-geometry true
    }

    window-rule {
        match is-floating=true

        focus-ring {
            on
            width 3
            active-color "#f38ba8" // Catppuccin Mocha Red
            active-gradient from="#f38ba8" to="#f5e0dc" angle=0
            // inactive-color "#f5e0dc" // Catppuccin Rosewater
        }
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    // Monitor & Workspace Management: floating, terminal window minimal size
    window-rule {
        match title="^move-monitor-position$|^move-all-workspaces-to-monitor$"
        open-floating true
        default-column-width { fixed 640; }
        default-window-height { fixed 320; }
    }

    // Plasma Emoji Selector: floating, minimal size
    window-rule {
        match title="Emoji Selector"
        open-floating true
        default-column-width { fixed 533; }
        default-window-height { fixed 426; }
    }

    // Satty: floating
    window-rule {
        match title="satty"
        open-floating true
    }

    // Cisco Anyconnect: floating, minimal size
    window-rule {
        match title="Cisco Secure Client"
        default-column-width { fixed 1000; }
    }
    window-rule {
        match title="Cisco Secure Client - Login"
        open-floating true
    }

    // File archiver: floating, adequate size
    window-rule {
        match app-id="^peazip$|^ark$"
        open-floating true
        default-column-width { fixed 1000; }
        default-window-height { fixed 800; }
    }

    // Full-width apps (100%)
    window-rule {
        match app-id="^firefox$|^cursor$"
        default-column-width { proportion 1.0; }
    }

    // Small utility apps (25%)
    window-rule {
        match app-id="^dolphin$|(?i)^org\\.gnome\\.Nautilus$|^nautilus$"
        default-column-width { proportion 0.25; }
    }

    // Medium communication/media apps (50%)
    window-rule {
        match app-id="^spotify$|^Beeper$|^Slack$|^vesktop$|^zed$|^Alacritty$"
        default-column-width { proportion 0.5; }
    }


    // ────────────── Workspace Routing Rules ──────────────

    // Workspace 1: Terminals
    window-rule { match app-id="^Termius$"; open-on-workspace "1"; }
    window-rule { match app-id="^alacritty-autostart$"; open-on-workspace "1"; }

    // Workspace 2: Coding
    window-rule {
        match app-id="^cursor$"
        open-on-workspace "2"
    }

    // Workspace 3: Firefox Work & Debugger
    window-rule {
        match app-id="^fx-w$"
        open-on-workspace "3"
        default-column-width { proportion 1.0; }
    }
    window-rule {
        match app-id="^fx-w-cli$"
        open-on-workspace "3"
        default-column-width { fixed 296; }
    }

    // Workspace 4: Productivity
    window-rule { match app-id="^Notion$"; open-on-workspace "4"; }
    window-rule { match app-id="^Zotero$"; open-on-workspace "4"; }
    window-rule { match app-id="^vesktop$"; open-on-workspace "4"; }

    // Workspace 5: Firefox Personal & Debugger
    window-rule {
        match app-id="^fx-p$"
        open-on-workspace "5"
        default-column-width { proportion 1.0; }
    }
    window-rule {
        match app-id="^fx-p-cli$"
        open-on-workspace "5"
        default-column-width { fixed 296; }
    }

    // Workspace 6: Media & Chat
    window-rule { match app-id="^Spotify$"; open-on-workspace "6"; }
    window-rule { match app-id="^Beeper$"; open-on-workspace "6"; }
